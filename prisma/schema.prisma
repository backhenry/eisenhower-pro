generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Task {
  id          String    @id @default(uuid())
  title       String
  isUrgent    Boolean
  isImportant Boolean
  isCompleted Boolean   @default(false)
  quadrantId  String
  userId      String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  @@index([userId])
}
